# TradePilot AI environment — SINGLE SOURCE OF TRUTH
#
# Edit THIS file only (repo root `.env`).
# `apps/api/.env` must be a symlink: `npm run env:link`
# Prisma CLI and the API both read through that link.
#
# Kite login UI still NEEDS these two values in env:
# - KITE_API_KEY    → builds login URL + every Kite Authorization header
# - KITE_API_SECRET → exchanges request_token → access_token AND encrypts session file
# The "Connect Kite" button does not replace these; it only obtains the daily access token.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trade_pilot_ai?schema=public"
DATARL="postgresql://postgres:postgres@localhost:5432/trade_pilot_ai?schema=public"
PERSISTENCE_MODE="mock"
PORT=4000
MARKET_TIMEZONE="Asia/Kolkata"
PAPER_STARTING_CAPITAL=100000
PAPER_MAX_RISK_PER_TRADE_PERCENT=1
PAPER_MAX_DAILY_LOSS_PERCENT=3
PAPER_MAX_TRADES_PER_DAY=8
PAPER_MAX_POSITION_SIZE=25000
PAPER_MAX_OPEN_POSITIONS=5
PAPER_MAX_CAPITAL_EXPOSURE=100000
PAPER_ALLOW_SHORT_SELLING=false
KITE_ACCOUNT_REFRESH_MIN_INTERVAL_MS=5000
KITE_QUOTE_BATCH_SIZE=400
MARKET_WS_RECONNECT_BASE_MS=1000
MARKET_WS_RECONNECT_MAX_MS=30000
MARKET_TICK_STALE_MS=15000
MARKET_SNAPSHOT_INTERVAL_MS=0
SCANNER_ENABLED=false
SCANNER_INTERVAL_MS=60000
SCANNER_MAX_CANDIDATES=25
SCANNER_MIN_SCORE=40
SCANNER_MIN_PRICE=20
SCANNER_MAX_PRICE=100000
SCANNER_MIN_VOLUME=1000
SCANNER_VOLUME_SPIKE_THRESHOLD=1.5
SCANNER_MIN_VOLATILITY=0.15
SCANNER_MAX_VOLATILITY=12
SCANNER_MAX_DATA_AGE_MS=30000
SCANNER_NEAR_HIGH_LOW_PERCENT=0.5
SCANNER_BREAKOUT_TOLERANCE_PERCENT=0.05
SCANNER_MOMENTUM_MIN_PERCENT=0.35
KITE_API_KEY=""
KITE_API_SECRET=""
KITE_REDIRECT_URL="http://127.0.0.1:4000/api/broker/kite/callback"
WEB_APP_URL="http://127.0.0.1:5173"
HISTORICAL_PROVIDER="mock"
HISTORICAL_PERSISTENCE_ENABLED=true
HISTORICAL_THROTTLE_MS=400
HISTORICAL_MAX_RETRIES=3
HISTORICAL_RETRY_BACKOFF_MS=750
HISTORICAL_CHUNK_DAYS_1M=5
HISTORICAL_CHUNK_OVERLAP_MINUTES=1
HISTORICAL_VALIDATE_ON_PERSIST=true
HISTORICAL_PERSIST_DERIVED_5M=true
# Browser → API base URL (Vite). Docker web build also sets this via Compose build args.
VITE_API_BASE_URL="http://localhost:4000"
